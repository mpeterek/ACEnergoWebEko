@page
@model ElectricityModel
@{
    ViewData["Title"] = "Elektřina – hlavní měření";
}

<p class="eyebrow">ELEKTŘINA</p>
<h1>Hlavní měření</h1>
<a asp-page="/Index">Zpět na přehled</a>
<section class="panel" aria-label="Seznam hlavních měření">
    @if (Model.Error is not null)
    {
        <p class="message-error" role="alert">@Model.Error</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="data-table">
                <caption class="visually-hidden">Hlavní měření elektřiny</caption>
                <thead>
                    <tr><th scope="col">ID</th><th scope="col">Název měření</th><th scope="col">Nastavení</th></tr>
                </thead>
                <tbody>
                    @foreach (var meter in Model.Meters)
                    {
                        <tr><td>@meter.Id</td><td>@meter.Name</td><td><a asp-page="/ElectricityTariffs" asp-route-meterId="@meter.Id">Tarify</a> · <a asp-page="/ElectricityHolidays" asp-route-meterId="@meter.Id">Svátky</a> · <a asp-page="/ElectricityPrices" asp-route-meterId="@meter.Id">Ceny</a> · <a asp-page="/ElectricityMeter" asp-route-meterId="@meter.Id">Konfigurace vstupů</a></td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Meters.Count == 0)
        {
            <p>Nejsou definována žádná hlavní měření.</p>
        }
    }
</section>
<p>Vyhodnocení, grafy a další konfigurace měření se teprve převádějí.</p>
