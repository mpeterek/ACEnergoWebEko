@page "{meterId:int}"
@model ElectricityPriceEditModel
@{ ViewData["Title"]="Editace cen"; }
@section Scripts {
<script src="~/js/pages/price-edit.js" asp-append-version="true" defer></script>
}
<h1>Editace cen @(Model.Data?.Name)</h1>
<a class="btn btn-outline-secondary btn-sm" asp-page="/ElectricityPrices" asp-route-meterId="@Model.MeterId" asp-route-Period="@Model.Period">Zpět na ceník</a>
@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="message-error" role="alert"></div>}
@if(Model.Data is not null){
<form method="post" class="panel configuration-form">
<input asp-for="MeterId" type="hidden" /><input asp-for="Period" type="hidden" /><input asp-for="Version" type="hidden" />
<p class="message-warning">Uložení přepíše ceny od @Model.Period do prosince stejného roku. Prázdná číselná položka znamená nezadanou hodnotu.</p>
<div class="configuration-grid">
@for(var i=0;i<ElectricityPriceStore.Fields.Length;i++){
 var field=ElectricityPriceStore.Fields[i];
 <div class="configuration-field"><label for="price-@i">@field.Label [<span data-unit-for="@field.Column">@ElectricityPriceStore.Unit(field.Column,Model.Values.ElementAtOrDefault(25)=="1" ? true : Model.Values.ElementAtOrDefault(25)=="0" ? false : null,Model.Values.ElementAtOrDefault(26)=="1" ? true : Model.Values.ElementAtOrDefault(26)=="0" ? false : null)</span>]</label>
 @if(field.Column.StartsWith("b")){
 <select name="Values[@i]" id="price-@i" data-unit-mode="@field.Column"><option value="" selected="@(string.IsNullOrEmpty(Model.Values.ElementAtOrDefault(i)))">Neuvedeno</option><option value="0" selected="@(Model.Values.ElementAtOrDefault(i)=="0")">@(field.Column.Contains("MWhProc")?"%":"Ne")</option><option value="1" selected="@(Model.Values.ElementAtOrDefault(i)=="1")">@(field.Column.Contains("MWhProc")?"MWh":"Ano")</option></select>
 }else{<input name="Values[@i]" id="price-@i" value="@Model.Values.ElementAtOrDefault(i)" inputmode="decimal" />}
 </div>
}
</div>
<label><input type="checkbox" name="Confirm" value="true" required /> Potvrzuji přepsání vybraného období až do konce roku.</label>
<div class="configuration-actions"><button class="btn btn-primary">Uložit ceny</button></div>
</form>
}
