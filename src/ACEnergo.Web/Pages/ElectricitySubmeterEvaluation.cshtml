@page "{id:int}"
@model ElectricitySubmeterEvaluationModel
@using System.Globalization
@using ACEnergo.Web.Domain
@{Layout="/Pages/Shared/_SubmeterLayout.cshtml";ViewData["Title"]="Elektřina – "+Model.Title;}
<h1>@(Model.Data?.Definition.Input.Name??"Podružné měření")</h1>
@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="message-error" role="alert"></div>}
<section class="panel evaluation-filter"><h2>@Model.Title</h2>
<form method="get" class="evaluation-form" data-workspace-form>
<input asp-for="View" type="hidden"/>
<div class="evaluation-period"><div><label asp-for="Mode">Období</label><select asp-for="Mode" class="form-select"><option value="day">Den</option><option value="month">Měsíc</option><option value="year">Rok</option></select></div><div><label asp-for="Date">Datum</label><input asp-for="Date" type="date" class="form-control" min="2000-01-01" max="9998-12-31" required/></div><button type="submit" class="btn btn-primary">Vyhodnotit</button></div>
<details class="evaluation-options" open="@(Model.View=="costs")"><summary>Podrobnosti a tarifní pásma</summary><div class="evaluation-option-fields"><div><label asp-for="Interval">Podrobnost denního přehledu</label><select asp-for="Interval" class="form-select"><option value="quarter">Čtvrthodiny</option><option value="hour">Hodiny</option></select><small>Platí pouze pro denní přehled.</small></div><div><label asp-for="MainMeterId">Tarify z hlavního měření</label><select asp-for="MainMeterId" class="form-select"><option value="">Bez přiřazeného tarifu</option>@foreach(var meter in Model.MainMeters){<option value="@meter.Id">@meter.Name (#@meter.Id)</option>}</select></div></div></details>
</form></section>
@if(Model.Data is {} data){
 var unit=data.Definition.Input.WorkUnit??"Neuvedeno";var powerUnit=data.Definition.Input.PowerUnit??"Neuvedeno";
 var shownWarnings=Model.View=="costs"?data.Warnings:!data.Complete?new[]{"Archiv není úplný. Součet zahrnuje pouze dostupné hodnoty; chybějící čtvrthodiny se nenahrazují nulou."}:Array.Empty<string>();
 <div class="evaluation-result-heading"><nav class="evaluation-views" aria-label="Zobrazení výsledků">
 @foreach(var item in new[]{(Key:"overview",Name:"Přehled"),(Key:"values",Name:"Spotřeba v tabulce"),(Key:"costs",Name:"Náklady")}){
 if(item.Key=="costs"&&Model.Mode=="year")continue;
 <a class="btn btn-sm @(Model.View==item.Key?"btn-primary":"btn-outline-primary")" asp-route-id="@Model.Id" asp-route-Mode="@Model.Mode" asp-route-Date="@Model.Date" asp-route-Interval="@Model.Interval" asp-route-MainMeterId="@Model.MainMeterId" asp-route-View="@item.Key" aria-current="@(Model.View==item.Key?"page":null)">@item.Name</a>
 }
 </nav><a class="btn btn-outline-secondary btn-sm" asp-page-handler="Export" asp-route-id="@Model.Id" asp-route-Mode="@Model.Mode" asp-route-Date="@Model.Date" asp-route-Interval="@Model.Interval" asp-route-MainMeterId="@Model.MainMeterId" data-native-navigation><i class="fa-solid fa-file-csv" aria-hidden="true"></i> CSV</a></div>
 @if(shownWarnings.Length>0){<div class="evaluation-notice" role="status"><strong>Upozornění k výsledkům</strong><ul>@foreach(var warning in shownWarnings){<li>@warning</li>}</ul></div>}
 @if(Model.View=="overview"){
 <div class="evaluation-summary"><div class="card"><div class="card-body"><h2>@(data.Complete?"Celková spotřeba":"Dostupná spotřeba · neúplná")</h2><strong>@ElectricitySubmeterEvaluationModel.Number(data.Energy) <small>@unit</small></strong></div></div><div class="card"><div class="card-body"><h2>Maximum čtvrthodinového výkonu</h2><strong>@ElectricitySubmeterEvaluationModel.Number(data.PeakPower) <small>@powerUnit</small></strong></div></div></div>
 <section class="panel consumption-chart"><div class="evaluation-chart-heading"><h2>Průběh spotřeby · @unit</h2><span>@data.Rows.Sum(r=>r.Samples) / @data.Rows.Sum(r=>r.Expected) čtvrthodin</span></div>
 @{
 var numbers=data.Rows.Where(r=>r.Energy.HasValue).Select(r=>r.Energy!.Value).Append(0m).ToArray();var min=numbers.Min();var max=numbers.Max();var span=max-min; if(span==0)span=1;
 string Y(decimal value)=>(210m-(value-min)/span*180m).ToString("0.###",CultureInfo.InvariantCulture);
 var baseline=decimal.Parse(Y(0),CultureInfo.InvariantCulture);
 }
 <svg viewBox="0 0 800 250" role="img" aria-label="Graf spotřeby; přesné hodnoty jsou v záložce Spotřeba v tabulce"><line x1="110" x2="780" y1="@Y(0)" y2="@Y(0)" class="chart-axis"/><text x="5" y="25">@ElectricitySubmeterEvaluationModel.Number(max)</text><text x="5" y="225">@ElectricitySubmeterEvaluationModel.Number(min)</text>
 @for(var i=0;i<data.Rows.Length;i++){var row=data.Rows[i];if(row.Energy is not decimal energy)continue;var x=110m+i*670m/data.Rows.Length;var valueY=decimal.Parse(Y(energy),CultureInfo.InvariantCulture);var height=Math.Max(Math.Abs(baseline-valueY),1);<rect x="@x.ToString("0.###",CultureInfo.InvariantCulture)" y="@Math.Min(valueY,baseline).ToString("0.###",CultureInfo.InvariantCulture)" width="@Math.Max(670m/data.Rows.Length-2,1).ToString("0.###",CultureInfo.InvariantCulture)" height="@height.ToString("0.###",CultureInfo.InvariantCulture)" class="@(row.Complete?"chart-complete":"chart-partial")"><title>@Model.Label(row): @ElectricitySubmeterEvaluationModel.Number(energy) @unit · @row.Status</title></rect>}
 <text x="110" y="245">@Model.Label(data.Rows.First())</text><text x="780" y="245" text-anchor="end">@Model.Label(data.Rows.Last())</text></svg>
 <p class="chart-legend"><span>Modrá · úplná data</span><span>Oranžová · neúplná data</span><span>Prázdné místo · bez hodnot</span></p></section>
 }
 else if(Model.View=="values"){
 <section class="panel evaluation-data"><h2>Naměřená spotřeba</h2><div class="evaluation-table-scroll"><table class="data-table measurement-table" data-evaluation-table><caption>@Model.Title · @data.Date.ToString("dd.MM.yyyy")</caption><thead><tr><th scope="col">@(Model.Mode=="day"?"Konec intervalu":Model.Mode=="year"?"Měsíc":"Den")</th><th scope="col">Spotřeba (@unit)</th><th scope="col">Max. ¼h (@powerUnit)</th><th scope="col">Platné / očekávané ¼h</th><th scope="col">Stav</th></tr></thead><tbody>
 @foreach(var row in data.Rows){<tr><th scope="row">@Model.Label(row)</th><td>@ElectricitySubmeterEvaluationModel.Number(row.Energy)</td><td>@ElectricitySubmeterEvaluationModel.Number(row.PeakPower)</td><td>@row.Samples / @row.Expected</td><td>@row.Status</td></tr>}
 </tbody></table></div></section>
 }
 else if(Model.View=="costs"){
 var bands=data.Rows.Any(r=>r.Bands.Any(v=>v.HasValue));
 <section class="panel evaluation-costs"><h2>Náklady za období</h2><p class="evaluation-total-cost"><strong>@ElectricitySubmeterEvaluationModel.Number(data.Cost)</strong> Kč</p><p>Vypočtené náklady podle spotřeby. Jednotkové ceny najdete v <a asp-page="/ElectricitySubmeter" asp-route-id="@Model.Id" asp-route-Section="prices">ceníku</a>.</p>
 <div class="evaluation-table-scroll"><table class="data-table measurement-table" data-evaluation-table><caption>Náklady · @data.Date.ToString("dd.MM.yyyy")</caption><thead><tr><th scope="col">@(Model.Mode=="day"?"Konec intervalu":"Den")</th>@if(bands){<th scope="col">Spotřeba NT (@unit)</th><th scope="col">Spotřeba VT (@unit)</th><th scope="col">Spotřeba víkend (@unit)</th>}<th scope="col">Náklady (Kč)</th><th scope="col">Stav</th></tr></thead><tbody>
 @foreach(var row in data.Rows){<tr><th scope="row">@Model.Label(row)</th>@if(bands){@foreach(var band in row.Bands){<td>@ElectricitySubmeterEvaluationModel.Number(band)</td>}}<td>@ElectricitySubmeterEvaluationModel.Number(row.Cost)</td><td>@row.Status</td></tr>}
 </tbody></table></div></section>
 }
 <details class="evaluation-reading-help"><summary>Jak číst údaje</summary><p>Typ @data.Definition.Input.Type · stanice/vstup @ElectricityFictitiousComposition.Address(data.Definition.Input.Id) · časový posun @data.Shift hod. Archivní čas označuje konec čtvrthodiny. Částečné součty nejsou úplnou spotřebou.</p></details>
}
