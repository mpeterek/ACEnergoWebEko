@page
@model IndexModel
@{
    ViewData["Title"] = "Přehled";
}

<p class="eyebrow">PŘEHLED ENERGIÍ</p>
<h1>Přehled</h1>
<p>Vyberte oblast měření. Uložené datové období můžete zkontrolovat níže.</p>
<section class="panel" aria-label="Výběr období">
    <form method="get" class="period-form">
        <label for="period">Datové období</label>
        <select id="period" name="period">
            @foreach (var month in Model.Months)
            {
                <option value="@month" selected="@(month == Model.Period)">@month</option>
            }
        </select>
        <button class="button" type="submit" disabled="@(Model.Months.Length==0)">Vybrat období</button>
    </form>
    @if (Model.Months.Length == 0)
    {
        <p role="status">Nejsou dostupné měsíční databáze. Ověřte nastavení složky Access:Directory.</p>
    }
    @if (Model.Error is not null)
    {
        <p class="message-error" role="alert">@Model.Error</p>
    }
</section>
<div class="module-grid">
    @foreach (var module in Model.Modules.Where(m => User.IsInRole("Administrator") || User.HasClaim("permission", m.Right)))
    {
        <article class="panel module-card">
            <h2>@module.Name</h2>
            @if (module.Right == "ElekView")
            {
                <nav class="dashboard-links" aria-label="Oddíly elektřiny">
                <a class="btn btn-outline-primary" asp-page="/Electricity">Hlavní měření</a>
                <button class="btn btn-outline-secondary" disabled title="Oddíl podružných měření včetně vyhodnocení dosud není převeden">Podružná měření · připravuje se</button>
                <a class="btn btn-outline-primary" asp-page="/ElectricityGroups" asp-route-kind="fictitious">Fiktivní měření</a>
                <a class="btn btn-outline-primary" asp-page="/ElectricityGroups" asp-route-kind="centres">Střediska</a>
                <a class="btn btn-outline-primary" asp-page="/ElectricityGroups" asp-route-kind="plants">Závody</a>
                </nav>
            }
            @if (module.Right == "ElekView")
            {
                <p>Hlavní měření: vstupy, ceny, tarify a svátky. Fiktivní měření, střediska a závody: konfigurace, složení a úpravy vazeb. Výpočty a grafy se převádějí.</p>
                <span class="badge">Částečně převedeno</span>
            }
            else
            {
                <p>Převod měření, sestav a výpočtů tohoto modulu dosud není dokončen.</p>
                <span class="badge">Čeká na migraci</span>
            }
        </article>
    }
</div>
