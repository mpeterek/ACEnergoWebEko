@page
@model LoginModel
@{
    ViewData["Title"] = "Přihlášení";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/login.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/pages/login.js" asp-append-version="true" defer></script>
}

<section class="panel login-panel" aria-labelledby="login-title">
    <p class="eyebrow">VÍTEJTE ZPĚT</p>
    <h1 id="login-title">Přihlášení</h1>
    <p>Přihlaste se svým stávajícím účtem ACEnergo.</p>
    <form method="post" class="stacked-form">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" role="alert"></div>
        }
        <label asp-for="Username">Uživatelské jméno</label>
        <input asp-for="Username" autocomplete="username" required maxlength="255" data-autofocus />
        <label asp-for="Password">Heslo</label>
        <div class="password-field">
            <input asp-for="Password" type="password" autocomplete="current-password" maxlength="255" />
            <button class="button password-toggle" type="button" aria-controls="Password" aria-pressed="false" data-password-toggle aria-label="Zobrazit heslo" title="Zobrazit heslo" data-hidden-icon="@Url.Content("~/images/eye-off.svg")" data-visible-icon="@Url.Content("~/images/eye.svg")" hidden><img src="~/images/eye-off.svg" width="24" height="24" alt="" aria-hidden="true" data-password-icon /></button>
        </div>
        <button class="button button-primary" type="submit">Přihlásit se</button>
    </form>
</section>

@if (Model.DiagnosticException is not null)
{
    <aside class="panel" aria-labelledby="diagnostic-title">
        <h2 id="diagnostic-title">Diagnostika MDB – místní vývoj</h2>
        <dl class="diagnostic-list">
            <dt>Skutečně použitý soubor</dt><dd>@Model.DiagnosticPath</dd>
            <dt>Provider</dt><dd>@Model.DiagnosticProvider</dd>
            <dt>Architektura procesu</dt><dd>@Model.DiagnosticProcess</dd>
            <dt>Typ chyby</dt><dd>@Model.DiagnosticException</dd>
        </dl>
        <p>Podrobnosti: Visual Studio → Zobrazení → Výstup → ASP.NET Core Web Server (případně Debug).</p>
        <p>Provider musí být nainstalovaný a mít stejnou bitovost jako proces aplikace.</p>
    </aside>
}
