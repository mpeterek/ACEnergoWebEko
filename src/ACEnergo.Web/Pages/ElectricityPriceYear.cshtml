@page "{meterId:int}"
@model ElectricityPriceYearModel
@{ ViewData["WideContent"] = true; ViewData["Title"] = "Elektřina – roční přehled cen"; }

@section Styles {
<link rel="stylesheet" href="~/lib/datatables/dataTables.dataTables.min.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/pages/prices.css" asp-append-version="true" />
}
@section Scripts {
<script src="~/lib/jquery/jquery.min.js" asp-append-version="true" defer></script>
<script src="~/lib/datatables/dataTables.min.js" asp-append-version="true" defer></script>
<script src="~/js/pages/prices.js" asp-append-version="true" defer></script>
}
<h1>Roční přehled cen @(Model.Months.FirstOrDefault()?.MeterName)</h1>
<nav class="page-navigation"><a asp-page="/Electricity">Hlavní měření</a><a asp-page="/ElectricityPrices" asp-route-meterId="@Model.MeterId" asp-route-Period="@Model.Period">Měsíční ceník</a></nav>
<section class="panel">
<form method="get" class="period-form"><label for="year-period">Rok podle vybraného měsíce</label><input id="year-period" class="month-input" type="month" name="Period" value="@Model.Period" required /><button class="button">Načíst rok</button></form>
</section>
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" role="alert"></div> }
@if (Model.Months.Length == 12)
{
<p>Chybějící ceník je označen jako neuložený. Hodnoty se nepřebírají z předchozího měsíce. Tento přehled nesčítá ceny ani nepočítá náklady.</p>
<section class="panel price-year"><div class="price-year-overflow"><table class="data-table price-table price-year-table" data-price-table data-price-year><caption>Rok @Model.Months[0].Month.Year</caption><thead><tr><th scope="col">Položka</th><th scope="col">Jednotka</th>
@foreach (var month in Model.Months) { <th scope="col"><a asp-page="/ElectricityPrices" asp-route-meterId="@Model.MeterId" asp-route-Period="@month.Month.ToString("yyyy-MM")" title="@month.Month.ToString("MM/yyyy")">@month.Month.ToString("MM")</a>@if(month.IsDefault){<span class="price-missing" title="Ceník není uložen" aria-label="Ceník není uložen">—</span>}</th> }
</tr></thead><tbody>
@for(var index=0;index<Model.Months[0].Values.Length;index++) { <tr><th scope="row">@Model.Months[0].Values[index].Label</th><td>@(Model.Months.Select(m=>m.Values[index].Unit).Distinct().Count()==1 ? Model.Months[0].Values[index].Unit : "Dle měsíce")</td>@foreach(var month in Model.Months){<td>@month.Values[index].Value@if(Model.Months.Select(m=>m.Values[index].Unit).Distinct().Count()>1){<small> @month.Values[index].Unit</small>}</td>}</tr> }
</tbody></table></div></section>
}
