<header class="site-header">
    <a class="brand" asp-page="/Index">ACEnergo<span>WebEko</span></a>
    <span class="site-description">Energetický informační systém</span>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form class="account-menu" method="post" asp-page="/Logout">
            <span>@User.Identity.Name</span>
            <button class="button" type="submit">Odhlásit</button>
        </form>
    }
</header>
