@page "{kind}"
@model ElectricityGroupsModel
@{Layout="/Pages/Shared/_GroupLayout.cshtml";}
@{ViewData["Title"]=Model.Heading;}
<h1>@Model.Heading</h1>
@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="message-error" role="alert"></div>}
@if(Model.Loaded){
<section class="card workspace-welcome"><div class="card-body">
<i class="fa-solid fa-arrow-pointer" aria-hidden="true"></i>
<h2>Vyberte měření vlevo</h2>
<p>Po výběru se zde zobrazí konfigurace vybraného měření. Jeho přiřazené položky otevřete ve stromu nebo tlačítkem @(Model.Kind=="plants"?"Položky závodu":"Položky vstupu").</p>
@if(Model.Rows.Length==0){<p role="status">V tomto oddílu zatím nejsou žádná měření.</p>}
</div></section>
}
