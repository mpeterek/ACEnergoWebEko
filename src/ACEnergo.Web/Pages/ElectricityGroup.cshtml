@page "{kind}/{id:int}"
@model ElectricityGroupModel
@{Layout="/Pages/Shared/_GroupLayout.cshtml";ViewData["WorkspaceData"]=Model.Data;}
@{ViewData["Title"]=Model.Heading;}
<p class="eyebrow">ELEKTŘINA · @Model.Heading</p><h1>@(Model.Data?.Name??Model.Heading)</h1>
<nav class="page-navigation"><a class="btn btn-outline-primary btn-sm" asp-page="/ElectricityGroupComposition" asp-route-kind="@Model.Kind" asp-route-id="@Model.Id">@(Model.Kind=="plants"?"Přiřazená střediska":"Přiřazené vstupy")</a><a class="btn btn-outline-primary btn-sm" asp-page="/ElectricityGroups" asp-route-kind="@Model.Kind">@Model.Heading</a><a class="btn btn-outline-primary btn-sm" asp-page="/Index">Přehled</a></nav>
@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="message-error" role="alert"></div>}
@if(TempData["GroupSaved"] is string saved){<p role="status">@saved</p>}
@if(Model.Data is not null){
<section class="panel">
<h2>Základní konfigurace</h2>
@if(Model.CanEdit){
<form method="post" class="configuration-form"><input asp-for="Version" type="hidden"/>
<div class="configuration-grid">
<div class="configuration-wide"><label asp-for="GroupName">Název měření</label><input asp-for="GroupName" class="form-control" maxlength="30" required/></div>
<div><label asp-for="PowerUnit">Jednotka výkonu</label><input asp-for="PowerUnit" class="form-control" maxlength="15"/></div>
<div><label asp-for="EnergyUnit">Jednotka energie</label><input asp-for="EnergyUnit" class="form-control" maxlength="15"/></div>
@if(Model.Kind!="fictitious"){
<div class="configuration-wide"><label asp-for="MainMeterId">Hlavní měření</label>
<select asp-for="MainMeterId" class="form-select" aria-describedby="main-meter-help"><option value="">Bez hlavního měření</option>
@if(Model.MainMeterId is >0&&!Model.MainMeters.Any(m=>m.Id==Model.MainMeterId)){<option value="@Model.MainMeterId">Nedostupné měření #@Model.MainMeterId (uložená vazba)</option>}
@foreach(var meter in Model.MainMeters){<option value="@meter.Id">@meter.Name (#@meter.Id)</option>}
</select><small id="main-meter-help" class="text-secondary">Hlavní měření určuje přebíraná tarifní pásma.</small>
@if(Model.Kind=="plants"){<p class="configuration-help">Odpojení hlavního měření vypne přepočet ztrát u všech položek tohoto závodu.</p>}
</div>}
@if(Model.Kind=="centres"){
<div class="configuration-wide"><label asp-for="Recalculate">Přepočet střediska</label><select asp-for="Recalculate" class="form-select"><option value="">Neuvedeno</option><option value="true">Zapnutý</option><option value="false">Vypnutý</option></select><small class="text-secondary">Uložený příznak střediska; přepočet jednotlivých vazeb v závodu se nastavuje v položkách závodu.</small></div>
}
</div>
<div class="configuration-actions"><button class="btn btn-primary" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i> Uložit změny</button></div>
</form>
}else{
<dl class="configuration-summary"><dt>Název</dt><dd>@Model.Data.Name</dd><dt>Jednotka výkonu</dt><dd>@(Model.Data.PowerUnit??"Neuvedeno")</dd><dt>Jednotka energie</dt><dd>@(Model.Data.EnergyUnit??"Neuvedeno")</dd>
@if(Model.Data.MainMeter is not null){<dt>Hlavní měření</dt><dd>@(Model.MainMeters.FirstOrDefault(m=>m.Id.ToString()==Model.Data.MainMeter)?.Name??(Model.Data.MainMeter=="0"?"Bez hlavního měření":Model.Data.MainMeter))</dd>}
@if(Model.Data.Recalculation is not null){<dt>Přepočet střediska</dt><dd>@(Model.Data.Recalculation=="True"?"Zapnutý":Model.Data.Recalculation=="False"?"Vypnutý":"Neuvedeno")</dd>}
</dl>}
</section>
<section class="panel table-scroll"><table class="data-table price-table" data-price-table>
<caption>Přiřazené vstupy a uložené koeficienty</caption>
<thead><tr><th scope="col">@(Model.Kind=="plants"?"ID střediska":"Stanice / vstup")</th><th scope="col">Název</th><th scope="col">Výkon</th><th scope="col">Energie</th><th scope="col">Koeficient A</th><th scope="col">Koeficient B</th><th scope="col">Koeficient P</th>@if(Model.Kind=="plants"){<th scope="col">Uložený příznak přepočtu</th>}</tr></thead>
<tbody>@foreach(var row in Model.Data.Components){<tr><td>@ElectricityGroupCompositionEditor.ComponentLabel(Model.Kind!,row.Input)</td><td>@if(Model.Kind=="plants"&&row.Defined){<a class="btn btn-outline-primary btn-sm" asp-page="/ElectricityGroup" asp-route-kind="centres" asp-route-id="@row.Input">@row.Name</a>}else if(Model.Kind=="centres"&&row.Input>=ElectricityGroupCompositionEditor.FictitiousOffset&&row.Defined){<a class="btn btn-outline-primary btn-sm" asp-page="/ElectricityGroup" asp-route-kind="fictitious" asp-route-id="@row.Input">@row.Name</a>}else{@row.Name} @if(!row.Defined){<span class="badge">Chybějící definice</span>}</td><td>@row.PowerUnit</td><td>@row.EnergyUnit</td><td>@row.A</td><td>@row.B</td><td>@row.P</td>@if(Model.Kind=="plants"){<td>@row.Recalculation</td>}</tr>}</tbody>
</table></section>
@if(Model.Data.Components.Length==0){<p role="status">Konfigurace nemá přiřazené žádné položky.</p>}
}
<p>Správu přiřazených položek otevřete odkazem Přiřazené vstupy. Výpočty spotřeb a grafy se dále převádějí.</p>
